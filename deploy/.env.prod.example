DOMAIN=practicarta.example.com
LEGACY_DOMAIN=legacy.practicarta.example.com
DEBUG=False
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=practicarta.example.com
CSRF_TRUSTED_ORIGINS=https://practicarta.example.com
PUBLIC_BASE_URL=https://practicarta.example.com
POSTGRES_DB=practicarta
POSTGRES_USER=practicarta
POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql://practicarta:replace-with-a-long-random-value@db:5432/practicarta
GEMINI_API_KEY=replace-at-deploy-time
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Email de recuperación. Para SES, primero verifica el remitente/dominio y
# solicita salir del sandbox; no guardes estas credenciales en Git.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-ses-smtp-user
EMAIL_HOST_PASSWORD=replace-with-ses-smtp-password
DEFAULT_FROM_EMAIL=PractiCarta <no-reply@practicarta.example.com>
PASSWORD_RESET_TIMEOUT=86400
SECURE_HSTS_SECONDS=15552000
