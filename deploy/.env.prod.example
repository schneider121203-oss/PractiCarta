DOMAIN=practicarta.example.com
LEGACY_DOMAIN=legacy.practicarta.example.com
DEBUG=False
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=practicarta.example.com
CSRF_TRUSTED_ORIGINS=https://practicarta.example.com
PUBLIC_BASE_URL=https://practicarta.example.com
POSTGRES_DB=practicarta
POSTGRES_USER=practicarta
POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql://practicarta:replace-with-a-long-random-value@db:5432/practicarta
GEMINI_API_KEY=replace-at-deploy-time
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Browser-visible by design. Restrict in Google Cloud to Maps Embed API and
# https://practicarta.example.com/* before adding it here.
GOOGLE_MAPS_EMBED_API_KEY=
