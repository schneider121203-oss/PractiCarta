{$DOMAIN} {
    encode zstd gzip

    handle_path /static/* {
        root * /srv/static
        header Cache-Control "public, max-age=3600"
        file_server
    }

    handle_path /media/* {
        root * /srv/media
        header Cache-Control "public, max-age=86400"
        file_server
    }

    reverse_proxy web:8000
}
