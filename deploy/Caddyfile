{$LEGACY_DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
    encode zstd gzip
    header {
        -Server
        Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.openstreetmap.org"
        Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
        Referrer-Policy "same-origin"
    }

    handle_path /static/* {
        root * /srv/static
        header Cache-Control "public, max-age=3600"
        file_server
    }

    handle_path /media/* {
        root * /srv/media
        header Cache-Control "public, max-age=86400"
        file_server
    }

    reverse_proxy web:8000
}
